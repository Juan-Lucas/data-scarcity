}

%% ====================================================================
%% SUPPLY CHAIN MANAGEMENT, DEMAND FORECASTING & BIG DATA ANALYTICS
%% ====================================================================

@article{Seyedan2020,
   author = {Seyedan, Mehdi and Mafakheri, Fariborz},
   title = {Predictive Big Data Analytics for Supply Chain Demand Forecasting: A Methodological Perspective},
   journal = {International Journal of Big Data Management},
   year = {2020},
   volume = {1},
   pages = {59--83},
   abstract = {Literature review identifying seven dominant methods for demand forecasting in supply chains: neural networks, regression analysis, ARIMA, support vector machines, decision trees, K-nearest neighbors, and clustering. Highlights neural networks and regression as most prevalent. Reveals research gaps in closed-loop supply chains, external data integration, and hybrid modeling approaches relevant to data-scarce contexts.}
}

@article{Bai2022,
   author = {Bai, Bingfeng},
   title = {Acquiring Supply Chain Agility through Information Technology Capability: The Role of Demand Forecasting in Retail Industry},
   journal = {International Journal of Information Management},
   year = {2022},
   volume = {63},
   pages = {102--118},
   abstract = {Demonstrates IT capability as indirect driver of supply chain agility, operating through demand forecasting as a mediating mechanism. Shows that collaborative forecasting, real-time data sharing (ERP, e-supply chain), and data quality improvements directly enhance responsiveness in retail environments. Evidence-based framework linking technology investment to operational resilience under demand volatility.}
}

@article{Agoro2023,
   author = {Agoro, Habeeb and James, Owen},
   title = {Developing a Cloud-Based AI Solution for Supply Chain Forecasting},
   journal = {Journal of Cloud Computing and Big Data Applications},
   year = {2023},
   volume = {12},
   pages = {45--67},
   abstract = {Architecture for cloud-native AI forecasting systems combining real-time data pipelines, ensemble machine learning models (SARIMAX, XGBoost, deep learning), and MLOps automation. Demonstrates 30\% improvement in forecast accuracy and 50\% reduction in planning cycle time. Addresses scalability, model retraining, and system integration challenges through microservices and APIs for legacy ERP connectivity.}
}

