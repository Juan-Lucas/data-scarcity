   journal = {Journal of King Saud University - Computer and Information Sciences},
   volume = {37},
   pages = {101850},
   year = {2025},
   publisher = {Elsevier}
}

%% ====================================================================
%% PROBABILISTIC FORECASTING & UNCERTAINTY QUANTIFICATION
%% ====================================================================

@article{Xu2019,
   author = {Xu, Yu and Wang, Yushu and Tang, Yanqing},
   title = {Probabilistic Load Forecasting for Buildings Considering Weather and Occupancy Uncertainty},
   journal = {Applied Energy},
   year = {2019},
   volume = {253},
   pages = {113--125},
   abstract = {Hybrid probabilistic forecasting model for building energy demand. Combines artificial neural networks (ANN) for normal load prediction with dedicated probabilistic sub-models for abnormal peak events. Integrates meteorological uncertainty and occupancy variability to provide prediction intervals rather than point estimates, enhancing decision-making under uncertainty.}
}

@article{Jiang2019,
   author = {Jiang, Shanhu and Ye, Wenyu and Shen, Zhiming},
   title = {Method for Probabilistic Flood Forecasting Considering Rainfall and Model Parameter Uncertainties},
   journal = {Journal of Hydrology},
   year = {2019},
   volume = {577},
   pages = {123--135},
   abstract = {Probabilistic forecasting framework integrating rainfall measurement uncertainty and hydrological model parameter uncertainty. Uses Monte Carlo sampling and Bayesian inference to produce probability distributions and confidence intervals. Demonstrates 26\% improvement in CRPS over deterministic models, providing actionable risk quantification for operational planning.}
}

