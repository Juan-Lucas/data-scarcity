%% TRANSFER LEARNING - Time Series & Data-Scarce Environments
%% ====================================================================

@article{Weber2021,
   author = {Weber, Jonathan and Forestier, Germain and Idoumghar, Lhassane and Muller, Pierre-Alain},
   title = {Transfer Learning with Time Series Data: A Systematic Mapping Study},
   journal = {Information Systems},
   year = {2021},
   abstract = {Systematic mapping study analyzing transfer learning approaches for time series across multiple domains. Identifies intra-domain and cross-domain transfer strategies, with emphasis on deep learning methods (CNN, LSTM, RNN) for data-scarce applications in healthcare, finance, and industrial IoT.}
}

@article{Fawaz2018,
   author = {Fawaz, Hassan Ismail and Forestier, Germain and Weber, Jonathan and Idoumghar, Lhassane and Muller, Pierre-Alain},
   title = {Transfer Learning for Time Series Classification},
   journal = {IEEE International Conference on Big Data},
   year = {2018},
   pages = {6135--6144},
   abstract = {Exhaustive empirical study of transfer learning on 85 UCR time series datasets. Tests 7140 model configurations to evaluate source domain selection impact. Demonstrates that Dynamic Time Warping (DTW) similarity metrics are effective for identifying optimal source domains, significantly improving classification accuracy in data-limited scenarios.}
}

@article{Fareed2025,
